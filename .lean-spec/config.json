{
  "template": "requirements-template.md",
  "templates": {
    "default": "requirements-template.md",
    "design": "design-template.md",
    "tasks": "tasks-template.md",
    "bugfix": "bugfix-template.md",
    "design-first": "design-first-template.md",
    "design-first-design": "design-first-design-template.md",
    "design-first-requirements": "design-first-requirements-template.md"
  },
  "specsDir": "specs",
  "structure": {
    "pattern": "flat",
    "sequenceDigits": 3,
    "defaultFile": "README.md"
  },
  "draftStatus": {
    "enabled": false
  },
  "validation": {
    "maxLines": 400,
    "warnLines": 200,
    "maxTokens": 5000,
    "warnTokens": 3500
  },
  "features": {
    "aiAgents": true,
    "examples": false,
    "tokenCounting": true,
    "dependencyGraph": true
  }
}
